# アップロード先での PHP 等のスクリプト実行を禁止（アップロード悪用対策）
php_flag engine off
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi .asp .aspx .sh
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
    AddType text/plain .php .phtml .pl .py .cgi
</IfModule>
# 画像のみ配信想定
<FilesMatch "\.(?i:jpe?g|png|webp|gif|svg)$">
    Require all granted
</FilesMatch>
